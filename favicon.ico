<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64">
  <defs>
    <filter id="glow" x="-50%" y="-50%" width="200%" height="200%">
      <feGaussianBlur stdDeviation="2" result="coloredBlur"/>
      <feMerge>
        <feMergeNode in="coloredBlur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
  </defs>
  <rect width="64" height="64" rx="14" fill="#040806"/>
  <circle cx="32" cy="32" r="28" fill="none" stroke="#10b981" stroke-width="2.5" />
  <circle cx="32" cy="32" r="22" fill="none" stroke="#10b981" stroke-width="1" stroke-dasharray="3 2" opacity="0.7"/>
  <text x="32" y="39" 
        font-family="system-ui, -apple-system, sans-serif" 
        font-size="19" 
        font-weight="900" 
        fill="#34d399" 
        stroke="#10b981"
        stroke-width="0.8"
        text-anchor="middle" 
        filter="url(#glow)">AM</text>
  <line x1="32" y1="2" x2="32" y2="7" stroke="#34d399" stroke-width="2.5"/>
  <line x1="32" y1="57" x2="32" y2="62" stroke="#34d399" stroke-width="2.5"/>
  <line x1="2" y1="32" x2="7" y2="32" stroke="#34d399" stroke-width="2.5"/>
  <line x1="57" y1="32" x2="62" y2="32" stroke="#34d399" stroke-width="2.5"/>
</svg>